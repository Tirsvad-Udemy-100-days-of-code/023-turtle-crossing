# Doxygen configuration for Turtle Crossing.
# Build with:  doxygen Doxyfile      (output goes to docs/api/)
PROJECT_NAME           = "Turtle Crossing"
PROJECT_BRIEF          = "Day 23 of 100 Days of Code: a Turtle Crossing game"
OUTPUT_DIRECTORY       = docs/api
INPUT                  = src README.md
FILE_PATTERNS          = *.py *.md
RECURSIVE              = YES
OPTIMIZE_OUTPUT_JAVA   = YES
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
JAVADOC_AUTOBRIEF      = YES
AUTOLINK_SUPPORT       = YES
MARKDOWN_SUPPORT       = YES
USE_MDFILE_AS_MAINPAGE = README.md
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HAVE_DOT               = NO
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_AS_ERROR          = NO
